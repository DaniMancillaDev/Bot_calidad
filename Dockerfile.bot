FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.title="Bot de Calidad Telegram" \
      org.opencontainers.image.revision="$SOURCE_COMMIT"

WORKDIR /app

# Instalar uv
COPY --from=ghcr.io/astral-sh/uv:latest@sha256:b485bd65cc2cf1c9a93b3554012c9c3778cf7b1b5fd3d3096ce9e1226c97e1e6 /uv /uvx /bin/

# Copiar dependencias primero para cache de capas
COPY pyproject.toml uv.lock ./

# Instalar solo dependencias de producción
RUN uv sync --frozen --no-dev

COPY bot/ bot/
COPY shared/ shared/
COPY main.py ./


# Usuario no-root para seguridad
RUN useradd -m -r -u 1001 botuser && \
    mkdir -p /app/media_files/fotos /app/data && \
    chown -R botuser:botuser /app

USER botuser

# El volumen se monta externamente (DB y fotos)
VOLUME ["/app/media_files", "/app/data"]

CMD ["uv", "run", "python", "main.py"]
