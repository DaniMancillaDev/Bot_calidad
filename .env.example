# ============================================
# Variables de entorno - Bot de Calidad
# ============================================
# Copia este archivo como .env y rellena los valores
# cp .env.example .env

# Telegram Bot Token (obtener de @BotFather)
TELEGRAM_TOKEN=tu_token_aqui

# Django (producción)
DJANGO_SECRET_KEY=genera_una_clave_secreta_aqui
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.com,localhost

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log
