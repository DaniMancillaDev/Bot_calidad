# ============================================
# Variables de entorno - Bot de Calidad
# ============================================
# Copia este archivo como .env y rellena los valores
# cp .env.example .env

# Telegram Bot Token (obtener de @BotFather)
TELEGRAM_TOKEN=tu_token_aqui

# Webhook (dejar vacío para usar polling en local)
# WEBHOOK_URL=https://iqa.danimancilladev.dev/webhook
# WEBHOOK_PORT=8001
# WEBHOOK_SECRET=genera_un_token_aleatorio_seguro  # openssl rand -hex 32

# Django (producción)
DJANGO_SECRET_KEY=genera_una_clave_secreta_aqui
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.com,localhost

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# ============================================
# Variables Docker (no necesarias en local)
# ============================================
# Ruta de la base de datos dentro del contenedor (volumen persistente)
# DB_PATH=/app/data/bot_calidad.db

# Ruta de las fotos dentro del contenedor (volumen compartido)
# FOTOS_PATH=/app/media_files/fotos

# Receptor interno de WhatsApp (fase 1; no guardar la clave en Git)
# WHATSAPP_INGEST_API_KEY=<clave larga aleatoria>
# WHATSAPP_ALLOWED_GROUP_IDS=<id-grupo-1,id-grupo-2>
# WHATSAPP_PENDING_ROOT=/ruta/privada/whatsapp_pending
# WHATSAPP_MAX_IMAGE_BYTES=26214400
# WHATSAPP_PROCESSING_LEASE_SECONDS=300
# Adaptador Baileys (deshabilitado por defecto; no usar secretos en Git)
# WHATSAPP_ENABLED=false
# WHATSAPP_SESSION_DIR=/app/data/whatsapp_session
# WHATSAPP_QUEUE_DIR=/app/data/whatsapp_queue
# WHATSAPP_INGEST_URL=http://web:8000/api/v1/whatsapp/ingest/
# WHATSAPP_QR_IN_TERMINAL=false
